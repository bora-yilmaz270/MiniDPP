@model ProductHistoryViewModel
@{
    ViewData["Title"] = "Sürüm geçmişi";
    var showCarbon = ViewData["ShowCarbon"] is true;
    var role = showCarbon ? "yetkili" : null;
}
<a class="back-link" href="@Url.Action("Passport", "Dpp", new { gtin = Model.Gtin, rol = role })">← Güncel pasaporta dön</a>
<section class="page-heading">
    <p class="eyebrow">DİJİTAL ÜRÜN PASAPORTU · SÜRÜM GEÇMİŞİ</p>
    <h1>@Model.ModelName</h1>
    <p class="muted mono">GTIN: @Model.Gtin</p>
    <p class="muted">Güncel sürüm ve önceki sürümler. Önceki sürümler değiştirilemeyen kayıtlar olarak saklanır.</p>
</section>

<section class="panel report-errors">
    <div class="section-title">
        <h2>Sürümler</h2>
        <span class="status-chip">Güncel: V@(Model.CurrentVersion)</span>
    </div>
    <table class="data-table version-history-table">
        <thead>
            <tr>
                <th>Sürüm</th>
                <th>Durum</th>
                <th>Güncelleme tarihi (UTC)</th>
                <th>Pasaport</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var version in Model.Versions)
        {
            var link = version.IsCurrent
                ? Url.Action("Passport", "Dpp", new { gtin = Model.Gtin, rol = role })
                : Url.Action("Version", "Dpp", new
                {
                    gtin = Model.Gtin,
                    versionNumber = version.VersionNumber,
                    rol = role
                });
            <tr>
                <td><strong>V@(version.VersionNumber)</strong></td>
                <td>
                    @if (version.IsCurrent)
                    {
                        <span class="status-chip">Güncel</span>
                    }
                    else
                    {
                        <span class="history-badge">Arşiv</span>
                    }
                </td>
                <td>
                    @if (version.ArchivedAtUtc.HasValue)
                    {
                        <time datetime="@version.ArchivedAtUtc.Value.ToString("O")">@version.ArchivedAtUtc.Value.ToString("dd.MM.yyyy HH:mm") UTC</time>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </td>
                <td><a class="text-link" href="@link">Görüntüle →</a></td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Versions.Count == 1)
    {
        <p class="muted">Henüz arşivlenmiş sürüm yok. Ürün bilgileri değiştirilen CSV tekrar içe aktarıldığında önceki sürüm burada görünecek.</p>
    }
</section>
<p class="muted small-note">Tarih, eski sürümün yeni sürümle değiştirildiği UTC zamanını gösterir. <code>?rol=yetkili</code> yalnızca görünürlük demosudur.</p>
